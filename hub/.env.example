# RESILINK GRID Hub Backend - Environment Variables Template
# Copy this file to .env and adjust as necessary for deployment

# Server Configuration
HUB_HOST=0.0.0.0
HUB_PORT=8000
HUB_DEBUG=False

# Cryptographic Keys (Load from secure enclave / HSM in production)
# 32-byte secret for audit HMAC-SHA256 hash chain
AUDIT_HMAC_KEY=resilink-hub-audit-hmac-secret-key-v4-2026

# Hub Authority ECDSA P-256 Private Key (hex-encoded 32-byte scalar)
HUB_PRIVATE_KEY_HEX=4a259c19b8849646c2fb3763f35062b9f3900be46fcad27d0a07409249e0a05a

# Geographic Center for Demo Facilities (Bangalore, Karnataka)
DEMO_CENTER_LAT=12.9716
DEMO_CENTER_LON=77.5946
